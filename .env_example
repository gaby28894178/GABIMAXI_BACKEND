# Base de datos (local)
DATABASE_URL=postgres://postgres:root@127.0.0.1:5432/<nombre_db>

# En Vercel/Render, usar POSTGRES_URL (se genera automáticamente)
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# JWT Secret (genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=tu_secreto_super_seguro_aqui_cambiar_en_produccion

# Ambiente (development, production)
NODE_ENV=development